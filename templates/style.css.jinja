@page {
    size: A4 landscape;
    margin: 15mm 12mm 20mm 12mm;

    @bottom-left {
        content: "{{ config.common.source }}";
        font-family: "Arial", "Liberation Sans", sans-serif;
        font-size: 8pt;
        color: #777;
    }

    @bottom-right {
        content: "стр. " counter(page);
        font-family: "Arial", "Liberation Sans", sans-serif;
        font-size: 8pt;
        color: #777;
    }
}

@page :first {
    @bottom-left { content: ""; }
    @bottom-right { content: ""; }
}

html, body {
    margin: 0;
    padding: 0;
    font-family: "Arial", "Liberation Sans", "DejaVu Sans", sans-serif;
    font-size: 10pt;
    color: #222;
    line-height: 1.4;
}

/* ---------- Титульная страница ---------- */

.cover {
    text-align: center;
    padding-top: 30mm;
    page-break-after: always;
}

.cover h1 {
    color: {{ config.common.colors.primary }};
    font-size: 24pt;
    margin: 0 0 4mm 0;
    line-height: 1.2;
}

.cover h2 {
    color: #2c3e50;
    font-size: 13pt;
    font-weight: normal;
    margin: 0 0 12mm 0;
}

.cover .description {
    text-align: justify;
    font-size: 10.5pt;
    margin: 0 auto 10mm auto;
    max-width: 200mm;
    line-height: 1.5;
}

.cover .meta {
    font-size: 9pt;
    color: {{ config.common.colors.text_muted }};
}

/* ---------- Таблица ---------- */

table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
}

thead {
    display: table-header-group;
}

th {
    background: {{ config.common.colors.primary }};
    color: #ffffff;
    font-weight: bold;
    font-size: 9pt;
    padding: 3mm 2mm;
    text-align: left;
    border: 0.3pt solid #bdc3c7;
}

td {
    font-size: 8pt;
    padding: 2mm;
    vertical-align: top;
    border: 0.3pt solid #bdc3c7;
    word-wrap: break-word;
}

tr {
    page-break-inside: avoid;
}

tbody tr.alt {
    background: {{ config.common.colors.row_alt }};
}

.area-row td {
    background: {{ config.common.colors.accent }};
    color: {{ config.common.colors.primary }};
    font-weight: bold;
    font-size: 10pt;
    padding: 2.5mm 3mm;
}

/* ---------- Отдельные колонки ---------- */

.col-n {
    text-align: center;
    width: 6%;
}

.col-qty {
    text-align: center;
}
